   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import neurokit2 as nk\n",
    "\n",
    "# Example: downsampled_datas[1] is at 100 Hz\n",
    "sampling_rate = 100\n",
    "slices = {\n",
    "    \"400 samples (4 sec)\": downsampled_datas[1][:400],\n",
    "    \"2500 samples (25 sec)\": downsampled_datas[1][:2500],\n",
    "    \"5000 samples (50 sec)\": downsampled_datas[1][:5000]\n",
    "}\n",
    "\n",
    "for title, ecg_slice in slices.items():\n",
    "    # Create time axis\n",
    "    time_axis = np.linspace(0, len(ecg_slice) / sampling_rate, len(ecg_slice))\n",
    "\n",
    "    # Run delineation\n",
    "    signals, info = nk.ecg_delineate(ecg_slice, sampling_rate=sampling_rate, show=False)\n",
    "\n",
    "    # Plot with time-based x-axis\n",
    "    plt.figure(figsize=(12, 4))\n",
    "    plt.plot(time_axis, ecg_slice, label=\"ECG\")\n",
    "    # plt.plot(time_axis, signals[\"ECG_R_Peaks\"] * max(ecg_slice), 'ro', label=\"R-peaks\")\n",
    "    plt.plot(time_axis, signals[\"ECG_P_Peaks\"] * max(ecg_slice), 'go', label=\"P-peaks\")\n",
    "    plt.plot(time_axis, signals[\"ECG_T_Peaks\"] * max(ecg_slice), 'bo', label=\"T-peaks\")\n",
    "    plt.title(f\"ECG Delineation - {title}\")\n",
    "    plt.xlabel(\"Time (seconds)\")\n",
    "    plt.ylabel(\"Amplitude\")\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
