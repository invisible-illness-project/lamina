       "<Figure size 1500x800 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import neurokit2 as nk\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "# Assuming s2_sigals_df['ECG_Clean'] exists and is cleaned ECG data\n",
    "downsample_to = [1, 100, 250]\n",
    "\n",
    "plt.figure(figsize=(15, 8))\n",
    "downsampled_datas = []\n",
    "for idx, i in enumerate(downsample_to, 1):\n",
    "    downsampled_data = nk.signal_resample(s2_sigals_df['ECG_Clean'].values, sampling_rate=700, desired_sampling_rate=i, method='pandas')\n",
    "    downsampled_datas.append(downsampled_data)\n",
    "    \n",
    "    # Convert to NumPy array for plotting\n",
    "    # downsampled_array = downsampled_data.values if hasattr(downsampled_data, 'values') else downsampled_data\n",
    "\n",
    "    plt.subplot(len(downsample_to), 1, idx)\n",
    "    plt.plot(downsampled_data)\n",
    "    plt.title(f\"Downsampled to {i} Hz\")\n",
    "    plt.xlabel(\"Samples\")\n",
    "    plt.ylabel(\"Amplitude\")\n",
    "\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
